<section id="custom-contact-{{ section.id }}" class="custom-contact-section">
  <div class="custom-contact-container">

    <div class="custom-contact-card custom-contact-form-card">
      <div class="custom-contact-header">
        {% if section.settings.form_title != blank %}
          <h2>{{ section.settings.form_title }}</h2>
        {% endif %}

        {% if section.settings.form_subtitle != blank %}
          <p>{{ section.settings.form_subtitle }}</p>
        {% endif %}
      </div>

      {% form 'contact', class: 'custom-contact-form' %}

        {% if form.posted_successfully? %}
          <div class="custom-contact-success">
            {{ section.settings.success_message }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="custom-contact-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="custom-contact-grid">
          <div class="custom-contact-field">
            <label for="ContactFormName-{{ section.id }}">
              {{ section.settings.name_label }}
              {% if section.settings.name_required %}
                <span>*</span>
              {% endif %}
            </label>
            <input
              id="ContactFormName-{{ section.id }}"
              type="text"
              name="contact[name]"
              {% if section.settings.name_required %}required{% endif %}
            >
          </div>

          <div class="custom-contact-field">
            <label for="ContactFormEmail-{{ section.id }}">
              {{ section.settings.email_label }}
              <span>*</span>
            </label>
            <input
              id="ContactFormEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
            >
          </div>
        </div>

        {% if section.settings.show_phone %}
          <div class="custom-contact-field">
            <label for="ContactFormPhone-{{ section.id }}">
              {{ section.settings.phone_label }}
              {% if section.settings.phone_required %}
                <span>*</span>
              {% endif %}
            </label>
            <input
              id="ContactFormPhone-{{ section.id }}"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              {% if section.settings.phone_required %}required{% endif %}
            >
          </div>
        {% endif %}

        <div class="custom-contact-field">
          <label for="ContactFormMessage-{{ section.id }}">
            {{ section.settings.message_label }}
            <span>*</span>
          </label>
          <textarea
            id="ContactFormMessage-{{ section.id }}"
            name="contact[body]"
            rows="6"
            required
          ></textarea>
        </div>

        {% if section.settings.show_marketing_checkbox %}
          <div class="custom-contact-consent">
            <label class="custom-contact-checkbox-wrapper">
              <input
                type="checkbox"
                name="contact[Marketing consent]"
                value="Yes"
              >
              <span class="custom-contact-checkbox"></span>
              <span class="custom-contact-consent-text">
                <strong>{{ section.settings.marketing_title }}</strong>
                <small>{{ section.settings.marketing_text }}</small>
              </span>
            </label>
          </div>
        {% endif %}

        <button type="submit" class="custom-contact-submit">
          {{ section.settings.button_label }}
        </button>

        {% if section.settings.legal_text != blank %}
          <div class="custom-contact-legal">
            {{ section.settings.legal_text }}
          </div>
        {% endif %}

      {% endform %}
    </div>

    <div class="custom-contact-card custom-contact-info-card">
      {% if section.settings.info_title != blank %}
        <h2>{{ section.settings.info_title }}</h2>
      {% endif %}

      <div class="custom-contact-company">
        {% if section.settings.company_name != blank %}
          <strong>{{ section.settings.company_name }}</strong>
        {% endif %}

        {% if section.settings.address_line_1 != blank %}
          <span>{{ section.settings.address_line_1 }}</span>
        {% endif %}

        {% if section.settings.address_line_2 != blank %}
          <span>{{ section.settings.address_line_2 }}</span>
        {% endif %}

        {% if section.settings.postal_city != blank %}
          <span>{{ section.settings.postal_city }}</span>
        {% endif %}

        {% if section.settings.country != blank %}
          <span>{{ section.settings.country }}</span>
        {% endif %}
      </div>

      <div class="custom-contact-details">
        {% if section.settings.phone != blank %}
          <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="custom-contact-detail">
            <span class="custom-contact-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.86 19.86 0 0 1 11.19 19a19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.12.91.33 1.8.62 2.65a2 2 0 0 1-.45 2.11L8 9.71a16 16 0 0 0 6.29 6.29l1.23-1.23a2 2 0 0 1 2.11-.45c.85.29 1.74.5 2.65.62A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            {{ section.settings.phone }}
          </a>
        {% endif %}

        {% if section.settings.email != blank %}
          <a href="mailto:{{ section.settings.email }}" class="custom-contact-detail">
            <span class="custom-contact-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"></path>
                <path d="m22 6-10 7L2 6"></path>
              </svg>
            </span>
            {{ section.settings.email }}
          </a>
        {% endif %}
      </div>

      {% if section.settings.extra_info != blank %}
        <div class="custom-contact-extra">
          {{ section.settings.extra_info }}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
  #custom-contact-{{ section.id }} {
    background: {{ section.settings.section_background }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.text_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.column_gap }}px;
  }

  #custom-contact-{{ section.id }} .custom-contact-card {
    background: {{ section.settings.card_background }};
    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.border_radius }}px;
    padding: {{ section.settings.card_padding }}px;
  }

  #custom-contact-{{ section.id }} .custom-contact-header {
    text-align: center;
    margin-bottom: 36px;
  }

  #custom-contact-{{ section.id }} h2 {
    margin: 0 0 10px;
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.2;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-header p {
    margin: 0;
    font-size: {{ section.settings.subtitle_size }}px;
    color: {{ section.settings.text_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-form {
    width: 100%;
  }

  #custom-contact-{{ section.id }} .custom-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  #custom-contact-{{ section.id }} .custom-contact-field {
    margin-bottom: 22px;
  }

  #custom-contact-{{ section.id }} label {
    display: block;
    margin-bottom: 10px;
    font-size: {{ section.settings.label_size }}px;
    color: {{ section.settings.text_color }};
  }

  #custom-contact-{{ section.id }} label span {
    color: {{ section.settings.required_color }};
  }

  #custom-contact-{{ section.id }} input,
  #custom-contact-{{ section.id }} textarea {
    width: 100%;
    border: 1px solid {{ section.settings.input_border_color }};
    border-radius: {{ section.settings.input_radius }}px;
    background: {{ section.settings.input_background }};
    color: {{ section.settings.text_color }};
    font-size: 15px;
    padding: 13px 14px;
    box-sizing: border-box;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  #custom-contact-{{ section.id }} input {
    height: {{ section.settings.input_height }}px;
  }

  #custom-contact-{{ section.id }} textarea {
    min-height: {{ section.settings.textarea_height }}px;
    resize: vertical;
  }

  #custom-contact-{{ section.id }} input:focus,
  #custom-contact-{{ section.id }} textarea:focus {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 2px {{ section.settings.accent_color }}26;
  }

  #custom-contact-{{ section.id }} .custom-contact-consent {
    background: {{ section.settings.consent_background }};
    border: 1px solid {{ section.settings.consent_border }};
    border-radius: {{ section.settings.input_radius }}px;
    padding: 16px;
    margin-bottom: 24px;
  }

  #custom-contact-{{ section.id }} .custom-contact-checkbox-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin: 0;
    cursor: pointer;
  }

  #custom-contact-{{ section.id }} .custom-contact-checkbox-wrapper input {
    display: none;
  }

  #custom-contact-{{ section.id }} .custom-contact-checkbox {
    width: 20px;
    height: 20px;
    min-width: 20px;
    border: 2px solid {{ section.settings.checkbox_color }};
    margin-top: 2px;
    box-sizing: border-box;
    position: relative;
  }

  #custom-contact-{{ section.id }} .custom-contact-checkbox-wrapper input:checked + .custom-contact-checkbox {
    background: {{ section.settings.checkbox_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-checkbox-wrapper input:checked + .custom-contact-checkbox::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 10px;
    border: solid {{ section.settings.checkbox_check_color }};
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  #custom-contact-{{ section.id }} .custom-contact-consent-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #custom-contact-{{ section.id }} .custom-contact-consent-text strong {
    font-size: 14px;
    color: {{ section.settings.heading_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-consent-text small {
    font-size: 12px;
    line-height: 1.45;
    color: {{ section.settings.text_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-submit {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border: none;
    cursor: pointer;
    background: {{ section.settings.button_background }};
    color: {{ section.settings.button_text_color }};
    border-radius: {{ section.settings.button_radius }}px;
    padding: 15px 32px;
    font-size: {{ section.settings.button_size }}px;
    font-weight: 700;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #custom-contact-{{ section.id }} .custom-contact-submit:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  #custom-contact-{{ section.id }} .custom-contact-legal {
    border-top: 1px solid {{ section.settings.legal_border_color }};
    margin-top: 32px;
    padding-top: 24px;
    font-size: {{ section.settings.legal_size }}px;
    line-height: 1.55;
    color: {{ section.settings.text_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-legal p {
    margin: 0 0 10px;
  }

  #custom-contact-{{ section.id }} .custom-contact-info-card h2 {
    margin-bottom: 22px;
  }

  #custom-contact-{{ section.id }} .custom-contact-company {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: {{ section.settings.info_text_size }}px;
    line-height: 1.35;
    color: {{ section.settings.info_text_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-company strong {
    color: {{ section.settings.heading_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: {{ section.settings.info_spacing }}px;
  }

  #custom-contact-{{ section.id }} .custom-contact-detail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: {{ section.settings.info_text_color }};
    text-decoration: none;
    font-size: {{ section.settings.info_text_size }}px;
  }

  #custom-contact-{{ section.id }} .custom-contact-detail:hover {
    color: {{ section.settings.accent_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-icon {
    width: 20px;
    height: 20px;
    color: {{ section.settings.icon_color }};
    display: inline-flex;
  }

  #custom-contact-{{ section.id }} .custom-contact-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #custom-contact-{{ section.id }} .custom-contact-extra {
    margin-top: 32px;
    font-size: {{ section.settings.info_text_size }}px;
    line-height: 1.55;
    color: {{ section.settings.info_text_color }};
  }

  #custom-contact-{{ section.id }} .custom-contact-success {
    background: #ecfdf3;
    border: 1px solid #bbf7d0;
    color: #166534;
    padding: 14px 16px;
    border-radius: {{ section.settings.input_radius }}px;
    margin-bottom: 22px;
  }

  #custom-contact-{{ section.id }} .custom-contact-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 14px 16px;
    border-radius: {{ section.settings.input_radius }}px;
    margin-bottom: 22px;
  }

  @media screen and (max-width: 900px) {
    #custom-contact-{{ section.id }} .custom-contact-container {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 600px) {
    #custom-contact-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #custom-contact-{{ section.id }} .custom-contact-card {
      padding: {{ section.settings.mobile_card_padding }}px;
    }

    #custom-contact-{{ section.id }} .custom-contact-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    #custom-contact-{{ section.id }} h2 {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    #custom-contact-{{ section.id }} .custom-contact-header {
      margin-bottom: 28px;
    }

    #custom-contact-{{ section.id }} .custom-contact-submit {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Custom contact form",
  "tag": "section",
  "class": "custom-contact-form-section",
  "settings": [
    {
      "type": "header",
      "content": "Form content"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Write to us"
    },
    {
      "type": "text",
      "id": "form_subtitle",
      "label": "Form subtitle",
      "default": "Contact us and we will get back to you as soon as possible."
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "checkbox",
      "id": "name_required",
      "label": "Name required",
      "default": true
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": true
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone number"
    },
    {
      "type": "checkbox",
      "id": "phone_required",
      "label": "Phone required",
      "default": false
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "What would you like to tell us?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit button label",
      "default": "Submit"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for your message. We will contact you shortly."
    },
    {
      "type": "header",
      "content": "Marketing consent"
    },
    {
      "type": "checkbox",
      "id": "show_marketing_checkbox",
      "label": "Show marketing consent checkbox",
      "default": true
    },
    {
      "type": "text",
      "id": "marketing_title",
      "label": "Marketing consent title",
      "default": "I would like to receive offers and commercial communications by email."
    },
    {
      "type": "textarea",
      "id": "marketing_text",
      "label": "Marketing consent text",
      "default": "By checking this box, you give your explicit consent to the processing of your email address for marketing purposes."
    },
    {
      "type": "richtext",
      "id": "legal_text",
      "label": "Legal text",
      "default": "<p>The information collected through this form is processed in order to respond to your request.</p><p><strong>Data collected:</strong> name, email, phone number and message.</p><p><strong>Purpose:</strong> response to your request. <strong>Legal basis:</strong> legitimate interest.</p><p><strong>Retention:</strong> 12 months. <strong>Recipients:</strong> customer service and technical support.</p><p><strong>Your rights:</strong> access, rectification and deletion. Contact us for any request.</p>"
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "text",
      "id": "info_title",
      "label": "Contact information title",
      "default": "Contact details"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name",
      "default": "Jad-Machinery-Group"
    },
    {
      "type": "text",
      "id": "address_line_1",
      "label": "Address line 1",
      "default": "9 Cours Gallieni"
    },
    {
      "type": "text",
      "id": "address_line_2",
      "label": "Address line 2",
      "default": "Dax"
    },
    {
      "type": "text",
      "id": "postal_city",
      "label": "Postal code and city",
      "default": "40100"
    },
    {
      "type": "text",
      "id": "country",
      "label": "Country",
      "default": "France"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "05 58 98 09 13"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "contact@jad-machinery-group.com"
    },
    {
      "type": "richtext",
      "id": "extra_info",
      "label": "Additional information",
      "default": "<p>Our team supports bakeries, pastry shops and food professionals with bakery machinery sales, installation, maintenance and after-sales service.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1500
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Space between columns",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_card_padding",
      "label": "Mobile card padding",
      "min": 15,
      "max": 50,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#f6f7f9"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#183052"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#183052"
    },
    {
      "type": "color",
      "id": "info_text_color",
      "label": "Contact information text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#183052"
    },
    {
      "type": "color",
      "id": "required_color",
      "label": "Required star color",
      "default": "#ff5a00"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Card border color",
      "default": "#d2d8e0"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Card border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Inputs"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "input_radius",
      "label": "Input border radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "input_height",
      "label": "Input height",
      "min": 40,
      "max": 80,
      "step": 2,
      "default": 44
    },
    {
      "type": "range",
      "id": "textarea_height",
      "label": "Textarea minimum height",
      "min": 100,
      "max": 260,
      "step": 10,
      "default": 130
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "color",
      "id": "button_background",
