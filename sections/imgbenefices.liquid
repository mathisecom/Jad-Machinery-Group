    {
      "type": "color",
      "id": "card_title_color",
      "label": "Couleur titres cartes",
      "default": "#062E1B"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Couleur textes cartes",
      "default": "#062E1B"
    },
    {
      "type": "range",
      "id": "card_title_size_desktop",
      "label": "Taille titre cartes PC",
      "min": 22,
      "max": 54,
      "step": 1,
      "default": 34
    },
    {
      "type": "range",
      "id": "card_title_size_mobile",
      "label": "Taille titre cartes mobile",
      "min": 20,
      "max": 42,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
      "id": "card_text_size_desktop",
      "label": "Taille texte cartes PC",
      "min": 15,
      "max": 34,
      "step": 1,
      "default": 28
    },
    {
      "type": "range",
